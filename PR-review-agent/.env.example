APP_ENV=development
DATABASE_PATH=data/reviews.sqlite3
# GitHub App credentials are required for webhook intake and API access.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
# LLM and embedding credentials enable AI review and hosted embeddings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=repository_chunks
MAX_CONTEXT_TOKENS=12000
TOP_K=8
CONFIDENCE_THRESHOLD=0.80
SUMMARY_CONFIDENCE_THRESHOLD=0.60
WORKER_POLL_SECONDS=2
MAX_RETRIES=3
INDEX_SNAPSHOT_RETENTION=20
# COST_PER_MILLION_TOKENS=0.15
LOG_LEVEL=INFO
